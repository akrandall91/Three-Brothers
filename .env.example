# Copy this file to .env and fill in real values before running in production.

# Password required to log into /admin. Change this.
ADMIN_PASSWORD=changeme123

# Secret used to sign admin session tokens. If omitted, one is generated
# automatically and stored in data/.session-secret on first run.
# Set this explicitly in production so sessions survive restarts/redeploys.
SESSION_SECRET=

# Port the server listens on.
PORT=3000
